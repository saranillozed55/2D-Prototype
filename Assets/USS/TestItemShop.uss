:root {
    width: 100%;
    height: 100px;
}

.button:hover {
    scale: 1.1 1.1 1.1;
}

.button {
    transition-duration: 0.25s;
    scale: 1 1;
}

#Container:hover,
#Container:focus {
    background-color: rgba(255,255,255,0.1);
    border-left-width: 4px;
    border-left-color: rgb(255,210,50);
}


